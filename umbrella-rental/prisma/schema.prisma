// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Umbrella {
  id         Int       @id @default(autoincrement())
  number     Int       @unique // 1~100번 관리
  status     String    @default("available") // "available" | "rented"
  studentId  String?   // 대여자 학번
  renterName String?   // 대여자 이름
  phone      String?   // 대여자 전화번호
  rentedAt   DateTime?
  updatedBy  String    @default("system") // "student" | "admin"
}
