// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Umbrella {
  id         Int       @id @default(autoincrement())
  number     Int       @unique
  status     String    @default("available")
  studentId  String?
  renterName String?
  phone      String?
  pinHash    String?   // 추가: 반납(취소)용 비밀번호 해시
  rentedAt   DateTime?
  updatedBy  String    @default("system")
}
