generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Umbrella {
  id         Int       @id @default(autoincrement())
  number     Int       @unique
  status     String    @default("available")
  studentId  String?
  renterName String?
  phone      String?
  rentedAt   DateTime?
  updatedBy  String    @default("system")
}

model Student {
  id        Int    @id @default(autoincrement())
  studentId String @unique
  name      String
}
